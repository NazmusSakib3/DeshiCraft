# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/deshicraft

# JWT secrets (use long random strings in production)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters-long
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# CORS - the public URL of the client
CLIENT_URL=http://localhost:5173

# Seed admin (used by npm run seed)
SEED_ADMIN_EMAIL=admin@deshicraft.local
SEED_ADMIN_PASSWORD=Admin123!

# Payment sandbox (optional - COD works without this)
STRIPE_SECRET_KEY=

# Cloudinary image uploads (optional — sellers can still paste image URLs without this)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
